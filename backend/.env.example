DB_HOST=localhost
DB_PORT=5432
DB_NAME=furnipro_db
DB_USER=postgres
DB_PASSWORD=replace-with-your-password
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=60
# Alternatively set DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/furnipro_db
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set true behind HTTPS in deployment.
COOKIE_SECURE=false
